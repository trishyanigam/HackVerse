# ===================================================
# HackVerse Production Environment Configuration Example
# ===================================================

NODE_ENV=production
PORT=5000

# MongoDB Database URI (Atlas / Production Instance)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hackverse_prod?retryWrites=true&w=majority

# JWT Security Secrets (Must use strong 256-bit random keys)
JWT_ACCESS_SECRET=your_super_secret_production_access_key_32_bytes_min
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_super_secret_production_refresh_key_32_bytes_min
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Application URL for CORS Security & Email Links
CLIENT_URL=https://hackverse.yourdomain.com

# SMTP Email Configuration (Nodemailer Production)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_mailgun_api_key
SMTP_FROM_NAME="HackVerse Platform"
SMTP_FROM_EMAIL=noreply@yourdomain.com

# File Upload / Cloud Storage (Cloudinary / AWS S3)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
