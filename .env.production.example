# ===================================================
# HackVerse Production Environment Setup
# ===================================================

NODE_ENV=production
PORT=5000

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hackverse_db?retryWrites=true&w=majority

# JWT Authentication
JWT_ACCESS_SECRET=production_jwt_access_secret_key_change_me
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=production_jwt_refresh_secret_key_change_me
JWT_REFRESH_EXPIRES_IN=7d

# Application Client URL
CLIENT_URL=https://hackverse.yourdomain.com

# SMTP Credentials
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME="HackVerse Platform"
SMTP_FROM_EMAIL=noreply@hackverse.com
